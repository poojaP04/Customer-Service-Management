    <decisions>
        <description>Determines the Case assignment queue based on Service Category.</description>
        <name>Route_by_Service_Category</name>
        <label>Route by Service Category</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Technical_Support</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Service_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Technical Support</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Technical_Support_Queue</targetReference>
            </connector>
            <label>Technical Support</label>
        </rules>
        <rules>
            <name>Billing_Payments</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Service_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Billing &amp; Payments</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Billing_Support_Queue</targetReference>
            </connector>
            <label>Billing &amp; Payments</label>
        </rules>
        <rules>
            <name>General_Service_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Service_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>General Service Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_General_Support_Queue</targetReference>
            </connector>
            <label>General Service Request</label>
        </rules>
    </decisions>
    <description>Automatically assigns newly created Cases to the appropriate support queue based on Service Category.</description>
    <environments>Default</environments>
    <formulas>
