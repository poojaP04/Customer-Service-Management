<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Escalated_Case_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Escalation_Status__c, &quot;Escalated&quot;),
    ISBLANK(TEXT(Escalation_Reason__c))
)</errorConditionFormula>
    <errorDisplayField>Escalation_Reason__c</errorDisplayField>
    <errorMessage>Escalation Reason is required when a Case is escalated.</errorMessage>
</ValidationRule>
